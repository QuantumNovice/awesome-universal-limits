{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/awesome-universal-limits/data/schema/oscillation.schema.json",
  "title": "To-and-fro motion: oscillation frequency vs size",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Object class.",
      "type": "string",
      "enum": [
        "molecular",
        "lab",
        "living",
        "human",
        "astro"
      ]
    },
    "size_m": {
      "description": "Size of the oscillating object, m.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "freq_low_hz": {
      "description": "Lowest known oscillation frequency of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "freq_high_hz": {
      "description": "Highest known oscillation frequency of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "freq_example_hz": {
      "description": "Oscillation frequency of the marked example object.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "freq_max_hz": {
      "description": "Maximum allowable oscillation frequency; empty if none.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "max_basis": {
      "description": "Physics behind the maximum.",
      "enum": [
        "none",
        null
      ]
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
