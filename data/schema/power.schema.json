{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/awesome-universal-limits/data/schema/power.schema.json",
  "title": "Power vs mass",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Object class.",
      "type": "string",
      "enum": [
        "living",
        "human",
        "astro"
      ]
    },
    "mass_kg": {
      "description": "Mass of the engine, animal or object, kg.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "power_low_w": {
      "description": "Lowest known power of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "power_high_w": {
      "description": "Highest known power of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "power_example_w": {
      "description": "Power of the marked example object.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "power_max_w": {
      "description": "Maximum allowable power; empty if none.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "max_basis": {
      "description": "Physics behind the maximum.",
      "enum": [
        "eddington",
        "none",
        null
      ]
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
