{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/awesome-universal-limits/data/schema/genomes.schema.json",
  "title": "Genome size vs number of genes",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Kingdom.",
      "type": "string",
      "enum": [
        "virus",
        "bacterium",
        "fungus",
        "plant",
        "animal"
      ]
    },
    "genome_bp": {
      "description": "Genome length in base pairs (nucleotides for RNA viruses).",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "genes": {
      "description": "Protein-coding genes.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
