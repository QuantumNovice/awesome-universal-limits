{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/awesome-universal-limits/data/schema/biology.schema.json",
  "title": "Living things: mass vs length",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Class.",
      "type": "string",
      "enum": [
        "molecule",
        "virus",
        "cell",
        "animal",
        "plant",
        "fungus"
      ]
    },
    "length_m": {
      "description": "Largest linear dimension, m.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "mass_low_kg": {
      "description": "Lowest known mass of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "mass_high_kg": {
      "description": "Highest known mass of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "mass_example_kg": {
      "description": "Mass of the marked example object.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "mass_max_kg": {
      "description": "Maximum allowable mass; empty if none.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "max_basis": {
      "description": "Physics behind the maximum.",
      "enum": [
        "none",
        null
      ]
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
