{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/the-allowed-universe/data/schema/ai_benchmark_refs.schema.json",
  "title": "Benchmark reference levels",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "benchmark": {
      "description": "Benchmark.",
      "type": "string",
      "enum": [
        "imagenet",
        "mmlu",
        "gsm8k",
        "gpqa",
        "swebench",
        "arcagi"
      ]
    },
    "level": {
      "description": "Kind of reference level.",
      "type": "string",
      "enum": [
        "chance",
        "human",
        "ceiling"
      ]
    },
    "score_pct": {
      "description": "Level, percent.",
      "type": [
        "number",
        "null"
      ]
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "benchmark",
    "level",
    "name",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
