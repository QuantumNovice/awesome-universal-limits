{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/the-allowed-universe/data/schema/buildings.schema.json",
  "title": "Tallest buildings over time",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Kind.",
      "type": "string",
      "enum": [
        "ancient",
        "tower",
        "skyscraper"
      ]
    },
    "year": {
      "description": "Year completed (negative = BCE).",
      "type": [
        "number",
        "null"
      ]
    },
    "height_m": {
      "description": "Architectural height, m.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
