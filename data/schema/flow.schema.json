{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QuantumNovice/the-allowed-universe/data/schema/flow.schema.json",
  "title": "Volumetric flow vs channel size",
  "type": "object",
  "properties": {
    "id": {
      "description": "Unique id.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "description": "Label.",
      "type": "string",
      "minLength": 1
    },
    "category": {
      "description": "Object class.",
      "type": "string",
      "enum": [
        "living",
        "human",
        "earth"
      ]
    },
    "width_m": {
      "description": "Channel diameter or width, m.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "flow_low_m3_s": {
      "description": "Lowest known volumetric flow of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "flow_high_m3_s": {
      "description": "Highest known volumetric flow of the class.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "flow_example_m3_s": {
      "description": "Volumetric flow of the marked example object.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "flow_max_m3_s": {
      "description": "Maximum allowable volumetric flow; empty if none.",
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "max_basis": {
      "description": "Physics behind the maximum.",
      "enum": [
        "none",
        null
      ]
    },
    "source_url": {
      "description": "Primary source for the values (journal DOI, agency fact sheet, spec sheet).",
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "citation": {
      "description": "Short citation: authors, year, title, venue.",
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "description": "One line shown in the hover tooltip.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "source_url",
    "citation"
  ],
  "additionalProperties": false
}
